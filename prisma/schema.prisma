model AllowedUser {
  id    Int    @id @default(autoincrement())
  // id    String @id @default(cuid())
  type  String @default("EMAIL") // EMAIL (String), TELEGRAM (Int)
  value String @default("")

  @@unique([type, value])
  @@map("allowed_users")
}

// User settings

model UserSettings {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  showOnlyMyData Boolean? @default(false)

  // The application language.
  locale String? // Language code ("en", "ru", ee the defintion in `src/i18n/types.ts`

  // The application theme: the color and the dark/light/system switch
  theme      String?
  themeColor String?

  // An optional language code and name to find topics
  langCode   String? // Language code (eg, "en", "ru", etc, or custom)
  langName   String? // Language name
  langCustom Boolean? // Is the language a custom one?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@map("user_settings")
}

